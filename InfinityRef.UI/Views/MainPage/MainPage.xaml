<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"  
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"  
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"  
             xmlns:behaviors="clr-namespace:InfinityRef.Behaviors"
             x:Class="InfinityRef.MainPage"
             x:Name="RootPage"
             Shell.NavBarIsVisible="False">

    <Grid>
            <ContentView x:Name="Viewport"   
                        BackgroundColor="Transparent">
                <ContentView.GestureRecognizers>
                    <DropGestureRecognizer AllowDrop="True" 
                                           DragOver="DragOver"
                                           Drop="OnDrop" />
                    <PanGestureRecognizer />
                    <PinchGestureRecognizer/>
                </ContentView.GestureRecognizers>

                <skia:SKCanvasView x:Name="CanvasView"                              
                                   PaintSurface="OnPaintSurface" 
                                   EnableTouchEvents="True">
                <skia:SKCanvasView.Behaviors>
                    <behaviors:PanZoomBehaviour CanvasInteractionService="{Binding Source={x:Reference RootPage}, Path=CanvasInteractionService}" />
                </skia:SKCanvasView.Behaviors>
            </skia:SKCanvasView>
            </ContentView>
    </Grid>  
</ContentPage>                

